# Application Configuration
PORT=3000
APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=1d
# Auto-Logout Inactivity Period (Default: 5 minutes)
IDLE_TIMEOUT_MINUTES=5
VITE_IDLE_TIMEOUT_MINUTES=5

# MongoDB connection string (Native MongoDB Driver)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/kasirwarungdb"

# Upstash Redis connection string for Token Bucket rate limiting and token blacklist
REDIS_URL="rediss://default:password@endpoint.upstash.io:6379"

# SMTP Mail configuration
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_USER="noreply@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="KasirWarung <noreply@example.com>"
